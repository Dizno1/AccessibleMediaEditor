{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Accessible Production Studio main window permissions.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-set-title",
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "name": "ffmpeg", "cmd": "ffmpeg", "sidecar": true, "args": true }]
    }
  ]
}
