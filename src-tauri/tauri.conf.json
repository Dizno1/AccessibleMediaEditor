{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Accessible Media Editor",
  "version": "0.11.1",
  "identifier": "org.opendoordesign.accessiblemediaeditor",
  "build": { "frontendDist": "../dist", "devUrl": null, "beforeDevCommand": "node scripts/prepare-dist.js", "beforeBuildCommand": "node scripts/prepare-dist.js" },
  "app": {
    "windows": [],
    "security": { "csp": null, "assetProtocol": { "enable": true, "scope": ["**"] } },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "publisher": "Open Door Design",
    "copyright": "2026 Open Door Design",
    "shortDescription": "Screen-reader-first multimedia editing and authoring.",
    "longDescription": "Accessible Media Editor arranges video, images, narration, audio, text, and transitions through keyboard-first and screen-reader-first workflows.",
    "externalBin": ["binaries/ffmpeg"],
    "windows": { "wix": { "language": "en-US" }, "nsis": { "installMode": "currentUser", "languages": ["English"], "displayLanguageSelector": false } }
  }
}
